# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local ขึ้น git)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ใช้เฉพาะฝั่ง server (Route Handlers / Server Actions) — ห้ามใส่ NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ใช้ใน /api/admin/generate (ยังไม่ได้ implement ใน scaffold นี้ — เตรียมไว้สำหรับขั้นต่อไป)
GEMINI_API_KEY=
CLAUDE_API_KEY=

# origin ของแอป ใช้ประกอบ redirect URL ของ Google OAuth
NEXT_PUBLIC_SITE_URL=http://localhost:3000
